# Inoks Story Webnovel Environment Configuration
# Copy to .env and fill in your values

# LLM Provider (openai, anthropic, custom)
INOKS_STORY_LLM_PROVIDER=openai

# API Base URL (OpenAI-compatible endpoint)
INOKS_STORY_LLM_BASE_URL=https://api.openai.com/v1

# API Key
INOKS_STORY_LLM_API_KEY=sk-your-key-here

# Model name
INOKS_STORY_LLM_MODEL=gpt-4o

# Notifications (optional)
INOKS_STORY_TELEGRAM_BOT_TOKEN=
INOKS_STORY_TELEGRAM_CHAT_ID=
INOKS_STORY_FEISHU_WEBHOOK_URL=
INOKS_STORY_WECOM_WEBHOOK_URL=
